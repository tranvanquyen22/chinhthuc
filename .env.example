# =========================================================================
# MAU CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES TEMPLATE)
# =========================================================================

# URL kết nối dịch vụ Supabase
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Khóa công khai Anon Key cho phép truy vấn từ phía Client (Browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# LƯU Ý BẢO MẬT:
# Tuyệt đối KHÔNG đưa SUPABASE_SERVICE_ROLE_KEY hoặc DATABASE_PASSWORD vào file này!
# Khóa Service Role có quyền ghi đè toàn bộ RLS và chỉ được dùng ở môi trường server bảo mật.
